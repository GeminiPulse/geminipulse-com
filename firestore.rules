rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file enforces the following data structures:
//
// Collection: showcase_projects
// Document ID: {projectId}
// Fields:
//   - id: string (optional, 1..120 chars, immutable) - Client-generated identifier
//   - name: string (required, 1..120 chars) - Project title
//   - creator: string (required, 1..80 chars) - Creator display name or handle
//   - authorUid: string (required, matches request.auth.uid, immutable) - Owner Firebase Auth UID
//   - category: string (required, enum: ['Agents', 'Voice & Live', 'Coding', 'Creative Media'])
//   - tagline: string (required, 1..600 chars) - Short technical summary
//   - models: list (required, 1..10 items) - Gemini models used
//   - architectureHighlight: string (required, 1..800 chars) - Architecture summary
//   - url: string (required, 1..300 chars) - Project or repository URL
//   - upvotes: int (required, >= 0) - Community upvote count
//   - verifiedByGemini: bool (required) - Moderation/curation verification flag
//   - featured: bool (required) - Featured showcase status
//   - status: string (required, == 'published', immutable) - Publication status
//   - createdAt: string (required, 1..50 chars, immutable) - ISO creation timestamp
//
// Collection: forum_threads
// Document ID: {threadId}
// Fields:
//   - id: string (optional, 1..120 chars, immutable) - Client-generated identifier
//   - title: string (required, 1..160 chars) - Discussion thread title
//   - author: string (required, 1..80 chars) - Author display name or handle
//   - authorUid: string (required, matches request.auth.uid, immutable) - Owner Firebase Auth UID
//   - category: string (required, enum: ['Architecture', 'Live API', 'Grounding & RAG', 'Multimodal Media'])
//   - tags: list (required, 1..10 items) - Discussion topic tags
//   - replies: int (required, >= 0) - Reply count
//   - upvotes: int (required, >= 0) - Thread upvote count
//   - createdAt: string (required, 1..50 chars, immutable) - ISO creation timestamp
//   - verifiedByGemini: bool (required) - Moderation verification flag
//   - body: string (required, 1..4000 chars) - Thread body content
//   - aiFirstResponse: string (required, 1..2000 chars) - Synthesized Gemini technical response
//   - comments: list (required, 0..200 items) - Thread replies list
//   - status: string (required, == 'published', immutable) - Publication status
//
// Collection: ai_news
// Document ID: {newsId}
// Access:
//   - Public read (get, list) ONLY when resource.data.status == 'published'
//   - Written exclusively by Cloud Functions Admin SDK (all client writes denied)
//
// Subcollection: forum_threads/{threadId}/replies
// Document ID: {replyId}
// Fields:
//   - id: string (optional, 1..120 chars, immutable) - Client-generated identifier
//   - threadId: string (required, 1..120 chars, == threadId path wildcard, immutable) - Parent thread ID
//   - author: string (required, 1..80 chars, immutable) - Reply author display name or handle
//   - authorUid: string (required, 1..128 chars, == request.auth.uid, immutable) - Owner Firebase Auth UID
//   - text: string (required, 1..2000 chars, immutable) - Reply text content
//   - status: string (required, == 'published', immutable) - Publication status
//   - createdAt: string (required, 1..50 chars, immutable) - ISO creation timestamp
//
// Collection: project_upvotes
// Document ID: {upvoteId} (deterministic: {projectId}_{request.auth.uid})
// Fields:
//   - projectId: string (required, 1..120 chars, immutable) - Target showcase project ID
//   - voterUid: string (required, 1..128 chars, == request.auth.uid, immutable) - Voter Firebase Auth UID
//   - createdAt: string (required, 1..50 chars, immutable) - ISO creation timestamp
//
// Collection: content_reports
// Document ID: {reportId}
// Access:
//   - Write-only community abuse/moderation report inbox (House Rule #6); client reads/updates/deletes denied
// Fields:
//   - targetId: string (required, 1..120 chars, immutable) - Reported item ID
//   - targetType: string (required, enum: ['showcase_project', 'forum_thread', 'forum_reply'], immutable)
//   - targetLabel: string (required, 1..200 chars, immutable) - Human-readable label of reported content
//   - reporterUid: string (required, 1..128 chars, == request.auth.uid, immutable) - Reporter Firebase Auth UID
//   - reason: string (required, 1..500 chars, immutable) - Report reason summary
//   - createdAt: string (required, 1..50 chars, immutable) - ISO creation timestamp
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isPublished() {
      return resource.data.status == 'published';
    }

    function isDocOwner() {
      return isAuthenticated() && resource.data.authorUid == request.auth.uid;
    }

    function authorUidUnchanged() {
      return request.resource.data.authorUid is string &&
        request.resource.data.authorUid.size() >= 1 &&
        request.resource.data.authorUid.size() <= 128 &&
        request.resource.data.authorUid == request.auth.uid;
    }

    function isImmutableMetaUnchanged() {
      return request.resource.data.authorUid == resource.data.authorUid &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.createdAt == resource.data.createdAt &&
        (!('id' in resource.data) || request.resource.data.id == resource.data.id);
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    function isValidOptionalString(field, minLen, maxLen) {
      return !(field in request.resource.data) ||
        (request.resource.data[field] is string &&
         request.resource.data[field].size() >= minLen &&
         request.resource.data[field].size() <= maxLen);
    }

    function isValidListRange(listData, minSize, maxSize) {
      return listData is list &&
        listData.size() >= minSize &&
        listData.size() <= maxSize;
    }

    // ===============================================================
    // Domain Validators (Used in BOTH create and update rules)
    // ===============================================================

    function isValidShowcaseProject(data) {
      let requiredFields = [
        'name',
        'creator',
        'authorUid',
        'category',
        'tagline',
        'models',
        'architectureHighlight',
        'url',
        'upvotes',
        'verifiedByGemini',
        'featured',
        'status',
        'createdAt'
      ];
      let allowedFields = [
        'id',
        'name',
        'creator',
        'authorUid',
        'category',
        'tagline',
        'models',
        'architectureHighlight',
        'url',
        'upvotes',
        'verifiedByGemini',
        'featured',
        'status',
        'createdAt'
      ];

      return hasRequiredFields(requiredFields) &&
        hasOnlyAllowedFields(allowedFields) &&
        isValidOptionalString('id', 1, 120) &&
        validStringLength('name', 1, 120) &&
        validStringLength('creator', 1, 80) &&
        authorUidUnchanged() &&
        data.category is string &&
        data.category in ['Agents', 'Voice & Live', 'Coding', 'Creative Media'] &&
        validStringLength('tagline', 1, 600) &&
        isValidListRange(data.models, 1, 10) &&
        data.models[0] is string &&
        data.models[0].size() >= 1 &&
        data.models[0].size() <= 100 &&
        validStringLength('architectureHighlight', 1, 800) &&
        validStringLength('url', 1, 300) &&
        data.upvotes is int &&
        data.upvotes >= 0 &&
        data.verifiedByGemini is bool &&
        data.featured is bool &&
        data.status is string &&
        data.status == 'published' &&
        validStringLength('createdAt', 1, 50);
    }

    function isValidForumThread(data) {
      let requiredFields = [
        'title',
        'author',
        'authorUid',
        'category',
        'tags',
        'replies',
        'upvotes',
        'createdAt',
        'verifiedByGemini',
        'body',
        'aiFirstResponse',
        'comments',
        'status'
      ];
      let allowedFields = [
        'id',
        'title',
        'author',
        'authorUid',
        'category',
        'tags',
        'replies',
        'upvotes',
        'createdAt',
        'verifiedByGemini',
        'body',
        'aiFirstResponse',
        'comments',
        'status'
      ];

      return hasRequiredFields(requiredFields) &&
        hasOnlyAllowedFields(allowedFields) &&
        isValidOptionalString('id', 1, 120) &&
        validStringLength('title', 1, 160) &&
        validStringLength('author', 1, 80) &&
        authorUidUnchanged() &&
        data.category is string &&
        data.category in ['Architecture', 'Live API', 'Grounding & RAG', 'Multimodal Media'] &&
        isValidListRange(data.tags, 1, 10) &&
        data.tags[0] is string &&
        data.tags[0].size() >= 1 &&
        data.tags[0].size() <= 60 &&
        data.replies is int &&
        data.replies >= 0 &&
        data.upvotes is int &&
        data.upvotes >= 0 &&
        validStringLength('createdAt', 1, 50) &&
        data.verifiedByGemini is bool &&
        validStringLength('body', 1, 4000) &&
        validStringLength('aiFirstResponse', 1, 2000) &&
        isValidListRange(data.comments, 0, 200) &&
        data.status is string &&
        data.status == 'published';
    }

    function isValidForumReply(data, threadId) {
      let requiredFields = [
        'threadId',
        'author',
        'authorUid',
        'text',
        'status',
        'createdAt'
      ];
      let allowedFields = [
        'id',
        'threadId',
        'author',
        'authorUid',
        'text',
        'status',
        'createdAt'
      ];

      return hasRequiredFields(requiredFields) &&
        hasOnlyAllowedFields(allowedFields) &&
        isValidOptionalString('id', 1, 120) &&
        validStringLength('threadId', 1, 120) &&
        data.threadId == threadId &&
        validStringLength('author', 1, 80) &&
        authorUidUnchanged() &&
        validStringLength('text', 1, 2000) &&
        data.status is string &&
        data.status == 'published' &&
        validStringLength('createdAt', 1, 50);
    }

    function isValidProjectUpvote(data) {
      let requiredFields = [
        'projectId',
        'voterUid',
        'createdAt'
      ];
      let allowedFields = [
        'projectId',
        'voterUid',
        'createdAt'
      ];

      return hasRequiredFields(requiredFields) &&
        hasOnlyAllowedFields(allowedFields) &&
        validStringLength('projectId', 1, 120) &&
        validStringLength('voterUid', 1, 128) &&
        data.voterUid == request.auth.uid &&
        validStringLength('createdAt', 1, 50);
    }

    function isValidContentReport(data) {
      let requiredFields = [
        'targetId',
        'targetType',
        'targetLabel',
        'reporterUid',
        'reason',
        'createdAt'
      ];
      let allowedFields = [
        'targetId',
        'targetType',
        'targetLabel',
        'reporterUid',
        'reason',
        'createdAt'
      ];

      return hasRequiredFields(requiredFields) &&
        hasOnlyAllowedFields(allowedFields) &&
        validStringLength('targetId', 1, 120) &&
        data.targetType is string &&
        data.targetType in ['showcase_project', 'forum_thread', 'forum_reply'] &&
        validStringLength('targetLabel', 1, 200) &&
        validStringLength('reporterUid', 1, 128) &&
        data.reporterUid == request.auth.uid &&
        validStringLength('reason', 1, 500) &&
        validStringLength('createdAt', 1, 50);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /showcase_projects/{projectId} {
      allow get, list: if isPublished();
      allow create: if isAuthenticated() && isValidShowcaseProject(request.resource.data);
      allow update: if isDocOwner() &&
        isValidShowcaseProject(request.resource.data) &&
        isImmutableMetaUnchanged();
      allow delete: if false;
    }

    match /forum_threads/{threadId} {
      allow get, list: if isPublished();
      allow create: if isAuthenticated() && isValidForumThread(request.resource.data);
      allow update: if isDocOwner() &&
        isValidForumThread(request.resource.data) &&
        isImmutableMetaUnchanged();
      allow delete: if false;

      match /replies/{replyId} {
        allow get, list: if isPublished();
        allow create: if isAuthenticated() && isValidForumReply(request.resource.data, threadId);
        allow update, delete: if false;
      }
    }

    match /ai_news/{newsId} {
      allow get, list: if isPublished();
      allow create, update, delete: if false;
    }

    match /project_upvotes/{upvoteId} {
      allow get, list: if true;
      allow create: if isAuthenticated() &&
        isValidProjectUpvote(request.resource.data) &&
        upvoteId == request.resource.data.projectId + '_' + request.auth.uid;
      allow update: if false;
      allow delete: if isAuthenticated() && resource.data.voterUid == request.auth.uid;
    }

    match /content_reports/{reportId} {
      allow get, list: if false;
      allow create: if isAuthenticated() && isValidContentReport(request.resource.data);
      allow update, delete: if false;
    }

    // Default deny all other collections and documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
